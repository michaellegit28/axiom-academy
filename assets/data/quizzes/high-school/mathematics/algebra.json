---
permalink: /assets/data/quizzes/high-school/mathematics/algebra.json
---
{%- assign bank = site.data.question_banks.high_school.mathematics.algebra -%}
{
  "exam": "high-school",
  "subject": "mathematics",
  "topic": "algebra",
  "questions": [
{%- for q in bank %}
    {
      "id": {{ q.id | jsonify }},
      "type": "objective",
      "question": {{ q.question | jsonify }},
      "options": {{ q.options | jsonify }},
      "correct": {{ q.answer_index }},
      "explanation": {{ q.explanation | jsonify }},
      "topic": {{ q.topic | jsonify }},
      "difficulty": {{ q.difficulty | jsonify }}
    }{% unless forloop.last %},{% endunless %}
{%- endfor %}
  ]
}
